APP_NAME=SendPortal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=pgsql
# When deploying on Neon use the pooled (-pooler) host to leverage PgBouncer.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sendportal_dev
DB_USERNAME=homestead
DB_PASSWORD=secret
DB_SSLMODE=prefer

# Optional Neon Postgres connection string override.
NEON_DATABASE_URL=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

SENDPORTAL_THROTTLE_MIDDLEWARE=60,1
SENDPORTAL_REGISTER=false
SENDPORTAL_PASSWORD_RESET=true

# Contact status integrations
GRPC_CONTACT_ENDPOINT=
GRPC_CONTACT_TIMEOUT=2.0
MONGODB_URI=
MONGODB_DATABASE=
MONGODB_CONTACTS_COLLECTION=contacts

# D7 Network SMS integration placeholders
D7_API_KEY=
D7_WEBHOOK_SECRET=

# Campaign slicing defaults
CAMPAIGN_SLICE_DEFAULT_SIZE=
CAMPAIGN_SLICE_INTERVAL_MINUTES=1440
